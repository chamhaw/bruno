+
+  return ({ children, items = [] }) => (
+    <div>
+      {children}
+      <div role="menu">
+        {items.map((item) => (
+          <button key={item.id} role="menuitem" onClick={item.onClick} disabled={item.disabled}>
+            {renderSection(item.leftSection, `${item.id}-icon`)}
